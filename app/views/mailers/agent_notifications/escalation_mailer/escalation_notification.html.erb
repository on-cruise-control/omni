<tr>
  <td style="padding:0;">

    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="font-family:'Outfit','Inter',-apple-system,system-ui,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Tahoma,Arial,sans-serif;">

      <tr>
        <td style="padding:20px 0 20px;">
          <p style="margin:0; font-size:16px; color:#000000; line-height:1.6;">
            We would like to bring to your immediate attention a customer interaction that requires urgent escalation and follow-up.
          </p>
        </td>
      </tr>

      <tr>
        <td style="padding:0 0 20px;">
          <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f9fafb; border-radius:8px;">
            <% if @dealership_name.present? %>
            <tr>
              <td style="padding:10px 14px; font-size:13px; color:#6b7280; width:100px;">Dealership Name</td>
              <td style="padding:10px 14px; font-size:14px; font-weight:600; color:#111827;"><%= @dealership_name %></td>
            </tr>
            <% end %>
            <% if @customer_name.present? && @customer_name != "(N/A)" %>
            <tr>
              <td style="padding:10px 14px; font-size:13px; color:#6b7280; width:100px; border-top:1px solid #e5e7eb;">Name</td>
              <td style="padding:10px 14px; font-size:14px; font-weight:600; color:#111827; border-top:1px solid #e5e7eb;"><%= @customer_name %></td>
            </tr>
            <% end %>
            <% if @customer_phone.present? && @customer_phone != "(N/A)" %>
            <tr>
              <td style="padding:10px 14px; font-size:13px; color:#6b7280; border-top:1px solid #e5e7eb;">Phone</td>
              <td style="padding:10px 14px; font-size:14px; font-weight:600; color:#111827; border-top:1px solid #e5e7eb;"><%= @customer_phone %></td>
            </tr>
            <% end %>
            <% if @customer_email.present? && @customer_email != "(N/A)" %>
            <tr>
              <td style="padding:10px 14px; font-size:13px; color:#6b7280; border-top:1px solid #e5e7eb;">Email</td>
              <td style="padding:10px 14px; font-size:14px; font-weight:600; color:#111827; border-top:1px solid #e5e7eb;"><%= @customer_email %></td>
            </tr>
            <% end %>
            <tr>
              <td style="padding:10px 14px; font-size:13px; color:#6b7280; border-top:1px solid #e5e7eb;">Platform</td>
              <td style="padding:10px 14px; font-size:14px; font-weight:600; color:#111827; border-top:1px solid #e5e7eb;"><%= @platform_name %><%= '(DM)' if @conversation&.inbox&.dm_channel? %></td>
            </tr>
          </table>
        </td>
      </tr>

      <% if @last_incoming_message.present? %>
      <tr>
        <td style="padding:0 0 6px;">
          <p style="margin:0; font-size:14px; font-weight:700; color:#111827;">Reason for Escalation: </p>
        </td>
      </tr>
      <tr>
        <td style="padding:0 0 20px;">
          <div style="background-color:#f3f4f6; border-radius:6px; padding:14px 16px;">
            <p style="margin:0 0 10px 0; font-size:14px; font-weight:700; color:#000000;">Message:</p>
            <%= simple_format(@last_incoming_message, style: 'margin:0 0 10px 0; font-size:14px; color:#374151; line-height:1.6;') %>
          </div>
        </td>
      </tr>
      <% end %>

      <% if @summary.present? %>
      <tr>
        <td style="padding:0 0 6px;">
          <p style="margin:0; font-size:14px; font-weight:700; color:#111827;">Conversation Summary</p>
        </td>
      </tr>
      <tr>
        <td style="padding:0 0 20px;">
          <div style="background-color:#f3f4f6; border-radius:6px; padding:14px 16px;">
            <%= simple_format(@summary, style: 'margin:0 0 10px 0; font-size:14px; color:#374151; line-height:1.6;') %>
          </div>
        </td>
      </tr>
      <% end %>

      <tr>
        <td style="padding:0 0 12px;">
          <p style="margin:0; font-size:15px; color:#000000; line-height:1.6;">
            We recommend treating this as a high-priority recovery opportunity to improve the customer experience and reinforce brand trust.
          </p>
        </td>
      </tr>

      <tr>
        <td style="padding:0 0 20px;">
          <p style="margin:0; font-size:15px; color:#000000; line-height:1.6;">
            Please confirm once the outreach has been completed.
          </p>
        </td>
      </tr>

      <tr>
        <td style="padding:4px 10px 28px; width:100%;">
          <table width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <!-- LEFT COLUMN -->
              <td valign="middle" style="padding-bottom:8px;">
                <table cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td align="left" valign="middle">
                      <a href="<%= @action_url %>"
                         style="display:inline-block; padding:9px 16px; background-color:#182933; color:#ffffff; font-size:12px; font-weight:500; text-decoration:none; border-radius:6px; white-space:nowrap;">
                        View Conversation
                      </a>
                    </td>
                  </tr>
                </table>
              </td>

              <!-- RIGHT COLUMN -->
              <td align="right" valign="middle" style="padding-bottom:8px;">
                <table cellpadding="0" cellspacing="0" border="0" align="right">
                  <tr>
                    <td align="right" valign="middle">
                      <span style="display:inline-block; background:#fee2e2; color:#cd1c1c; font-size:11px; font-weight:700; padding:4px 10px; border-radius:30px; border:1px solid #fca5a5; text-transform:uppercase; white-space:nowrap;">
                        Urgent Escalation
                      </span>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
        </td>
      </tr>

      <tr>
        <td style="padding:8px 10px 0; width:100%;">
          <%= unsubscribe_link %>
        </td>
      </tr>

    </table>

  </td>
</tr>
